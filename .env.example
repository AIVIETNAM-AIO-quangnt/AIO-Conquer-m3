# Copy to .env and fill in. .env is gitignored.
# `conquer3.config.settings.Settings` is the ONLY place these are read.
#
# POSTGRES_HOST/REDIS_HOST below point at `localhost`, matching docker-compose's
# host port mappings -- that's how every `conquer3` command runs today
# (`uv run conquer3 ...` on the host, or `uv run pytest`). `conquer3` isn't
# importable inside the airflow-* containers yet (see README's "Known gaps"), so
# nothing currently resolves these via the `c3net` bridge network. Once Layer 6
# wires `conquer3` into a container that runs on that network, *that* container's
# env needs the compose service names instead (`postgres`, `redis`) -- don't just
# copy this file's values in for it. OTEL_EXPORTER_OTLP_ENDPOINT is unaffected by
# any of this: it's a real external address (or unset), reachable the same way
# from host or container, with no local otel-collector container to route through.

# ── environment ───────────────────────────────────────────────
C3_ENV=local
C3_LOG_LEVEL=INFO
C3_SIM_EPOCH_ISO=2024-01-01T00:00:00Z   # anchor for step -> timestamp; do not change after data is loaded

# ── postgres warehouse ────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=conquer3
POSTGRES_USER=conquer3
POSTGRES_PASSWORD=change-me
# PgSettings defaults sslmode/channel_binding to require/require (Neon's own
# connection-string convention). The local docker-compose postgres image has no
# SSL configured, so local dev/smoke scripts need both disabled here -- set both
# to require when POSTGRES_HOST points at Neon (or another TLS-only Postgres).
POSTGRES_SSLMODE=disable
POSTGRES_CHANNEL_BINDING=disable

# ── airflow ───────────────────────────────────────────────────
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
AIRFLOW__CORE__EXECUTOR=LocalExecutor
# Generated by scripts/bootstrap.sh on first run. Empty disables Fernet encryption
# (fine for local dev); a non-empty value MUST be a real Fernet key (32 url-safe
# base64-encoded bytes) or Airflow crashes on startup.
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
# Advanced: override the metadata-DB connection string wholesale. Leave unset --
# the compose default already points at airflow-postgres below, which always uses
# fixed airflow/airflow credentials (matching upstream's own reference compose
# file), regardless of this override.
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me

# ── redis / online state ──────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
# RedisSettings defaults this to true -- managed Redis providers commonly
# require TLS (a plaintext connection just gets closed, no clear error). The
# local docker-compose redis image has no TLS configured, so local dev
# disables it here -- set true when REDIS_HOST points at a managed Redis.
REDIS_TLS=false
C3_STATE_KEY_PREFIX=c3
C3_STATE_TTL_DAYS=90
C3_STATE_CAS_RETRIES=3
C3_STATE_PG_FALLBACK=false

# ── mlflow (REMOTE — tracking, artifacts, and registry) ───────
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
MLFLOW_EXPERIMENT_NAME=paysim-fraud
C3_MODEL_NAME=paysim_fraud_clf
C3_MODEL_ALIAS=champion
# data/... is host-friendly (every conquer3 command runs on the host today, same
# reasoning as C3_DUCKDB_PATH below); /models is the *container* path once the
# `scorer` service (Layer 5) runs in Docker.
C3_MODEL_CACHE_DIR=data/models
C3_MODEL_CHAMPION_CACHE_FILE=data/models/champion.json
# Bounds resolve_champion()'s boot-time MLflow calls -- mlflow's own defaults (120s
# timeout, 7 retries with exponential backoff) can block for minutes even against a
# tracking server that refuses connections instantly.
C3_MODEL_RESOLVE_TIMEOUT_S=10
C3_MODEL_RESOLVE_MAX_RETRIES=2

# ── pathway ───────────────────────────────────────────────────
PATHWAY_LICENSE_KEY=                    # free "Scale" key from pathway.com/get-license; empty => psycopg fallback
C3_PATHWAY_PG_SINK=auto                 # auto | licensed | psycopg
C3_PATHWAY_MODE=streaming               # streaming | static
C3_PATHWAY_PERSIST_DIR=/pathway-state
C3_PATHWAY_AUTOCOMMIT_MS=500
C3_PATHWAY_REFRESH_MS=1000

# ── event transport ───────────────────────────────────────────
C3_EVENT_DIR=/events
C3_EVENT_ROTATE_SECONDS=3600
C3_EVENT_FSYNC_INTERVAL_MS=1000
C3_EVENT_STAGING_DIR=/staging

# ── duckdb ────────────────────────────────────────────────────
# /duckdb/... is the *container* path (the duckdbdata volume, mounted for when
# Layer 6 runs this inside airflow-scheduler). Host-side `conquer3` runs need a
# path it can actually create -- data/ is already gitignored except .gitkeep.
C3_DUCKDB_PATH=data/duckdb/analytics.duckdb
C3_DUCKDB_MEMORY_LIMIT=4GB
C3_DUCKDB_THREADS=4
C3_DUCKDB_TEMP_DIR=data/duckdb/tmp

# ── serving (Layer 5 -- `scorer` IS the inference endpoint; remote MLflow ──
# is storage only, never on the request path -- see README's Layer 5 section) ─
# A BentoML service (POST /predict, POST /model_info, deprecated POST
# /invocations; OpenAPI spec at /docs.json).
C3_SCORER_PORT=3000
# Host-published port for the scorer container (docker-compose.yaml). Kept
# separate from C3_SCORER_PORT above, which also sets bentoml's in-container
# listen port -- remapping only the host side (e.g. to dodge a host port
# conflict) must not change what the container itself binds to.
C3_SCORER_HOST_PORT=3000
C3_SCORER_HOST=0.0.0.0
C3_SCORER_WORKERS=2
C3_SCORER_TIMEOUT_S=60
# How often `conquer3 serve` re-resolves the champion after boot. The only
# recurring contact with remote MLflow; a version change restarts the `bentoml
# serve` child, never a per-request lookup.
C3_CHAMPION_POLL_S=300
# data/... is host-friendly, same reasoning as C3_MODEL_CACHE_DIR above; /models
# is the *container* path once `scorer` runs in Docker. Pointer file naming the
# champion version workers must load -- written by the supervisor, read by every
# worker at startup, so a worker never resolves a version on its own. Separate
# from C3_MODEL_CACHE_DIR (Layer 4's raw sklearn artifact cache), which this
# points into.
C3_ACTIVE_CHAMPION_FILE=data/models/active.json
# Dev only: passes --reload to `bentoml serve` (watches source via watchfiles,
# restarts on change) -- only useful paired with docker-compose.yaml's ./src
# bind mount. docker-compose.yaml sets this to true for the scorer service
# directly; leave unset/false here, and for any real deployment.
C3_SCORER_RELOAD=false
# Escape hatch: comma-separated "name:version" pairs that _preload_all_versions
# (service.py) skips without attempting to load. For a registry entry whose
# artifact crashes the process outright (e.g. a native segfault while
# unpickling) rather than raising a catchable Python exception -- the usual
# per-version try/except can't save you from that, since the process doing
# the catching is what dies. Leave empty normally; the real fix belongs in
# the registry (re-log or delete the bad version), not here.
C3_SCORER_SKIP_VERSIONS=
C3_DECISION_THRESHOLD=0.5

# ── ui (Layer 9 -- Streamlit console: Inference + Inspection tabs) ────────
# A client of `scorer` over HTTP; holds no model. localhost is host-friendly,
# same reasoning as C3_SCORER_URL below -- the `ui` compose service overrides
# it to `http://scorer:3000`.
C3_UI_HOST=0.0.0.0
C3_UI_PORT=8501
C3_SCORER_URL=http://localhost:3000
# Bounds the /events JSONL scan the Inspection tab does on every load, so a
# long-running scorer's accumulated history can never make the tab unloadable.
C3_UI_HISTORY_MAX_ROWS=50000
C3_UI_HISTORY_MAX_FILES=200
C3_UI_REQUEST_BATCH_SIZE=500
C3_UI_REQUEST_TIMEOUT_S=120

# ── observability (empty by default -- init_telemetry() installs no-op providers
# when OTEL_EXPORTER_OTLP_ENDPOINT is unset, so nothing here is required to run
# the stack; fill in once you have a remote LGTM/OTel stack -- app processes push
# OTLP straight to its own collector, no local collector container involved) ──
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.namespace=conquer3
# Reference only -- no conquer3 code reads these (Grafana/Tempo/Prometheus query
# APIs are things you or scripts/smoke/layer7_observability.sh look at, never
# something the app talks to). Used by that script's optional live-remote-stack
# reachability check, skipped entirely when these are blank.
GRAFANA_URL=
GRAFANA_USER=
GRAFANA_PASSWORD=
C3_TEMPO_QUERY_URL=
C3_PROMETHEUS_QUERY_URL=
C3_TEMPO_QUERY_URL=
C3_PROMETHEUS_QUERY_URL=

# ── kaggle (local optional; Colab uses userdata secrets instead) ─
KAGGLE_USERNAME=
KAGGLE_KEY=
C3_KAGGLE_DATASET=ealaxi/paysim1
# Where the raw PaySim1 CSV lives -- `conquer3 ingest download/bronze` and
# scripts/smoke/layer2_warehouse.sh all read this same value.
C3_PAYSIM_CSV_PATH=data/raw/paysim1.csv
