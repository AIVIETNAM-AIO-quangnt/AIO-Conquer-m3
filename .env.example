# Copy to .env and fill in. .env is gitignored.
# `conquer3.config.settings.Settings` is the ONLY place these are read.

# ── environment ───────────────────────────────────────────────
C3_ENV=local
C3_LOG_LEVEL=INFO
C3_SIM_EPOCH_ISO=2024-01-01T00:00:00Z   # anchor for step -> timestamp; do not change after data is loaded

# ── postgres warehouse ────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=conquer3
POSTGRES_USER=conquer3
POSTGRES_PASSWORD=change-me

# ── airflow ───────────────────────────────────────────────────
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
AIRFLOW__CORE__EXECUTOR=LocalExecutor
# Generated by scripts/bootstrap.sh on first run. Empty disables Fernet encryption
# (fine for local dev); a non-empty value MUST be a real Fernet key (32 url-safe
# base64-encoded bytes) or Airflow crashes on startup.
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
# Advanced: override the metadata-DB connection string wholesale. Leave unset --
# the compose default already points at airflow-postgres below, which always uses
# fixed airflow/airflow credentials (matching upstream's own reference compose
# file), regardless of this override.
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me

# ── redis / online state ──────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
C3_STATE_KEY_PREFIX=c3
C3_STATE_TTL_DAYS=90
C3_STATE_CAS_RETRIES=3
C3_STATE_PG_FALLBACK=false

# ── mlflow (REMOTE — tracking, artifacts, and registry) ───────
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
MLFLOW_EXPERIMENT_NAME=paysim-fraud
C3_MODEL_NAME=paysim_fraud_clf
C3_MODEL_ALIAS=champion
C3_MODEL_CACHE_DIR=/models
C3_MODEL_CHAMPION_CACHE_FILE=/models/champion.json

# ── pathway ───────────────────────────────────────────────────
PATHWAY_LICENSE_KEY=                    # free "Scale" key from pathway.com/get-license; empty => psycopg fallback
C3_PATHWAY_PG_SINK=auto                 # auto | licensed | psycopg
C3_PATHWAY_MODE=streaming               # streaming | static
C3_PATHWAY_PERSIST_DIR=/pathway-state
C3_PATHWAY_AUTOCOMMIT_MS=500
C3_PATHWAY_REFRESH_MS=1000

# ── event transport ───────────────────────────────────────────
C3_EVENT_DIR=/events
C3_EVENT_ROTATE_SECONDS=3600
C3_EVENT_FSYNC_INTERVAL_MS=1000
C3_EVENT_STAGING_DIR=/staging

# ── duckdb ────────────────────────────────────────────────────
C3_DUCKDB_PATH=/duckdb/analytics.duckdb
C3_DUCKDB_MEMORY_LIMIT=4GB
C3_DUCKDB_THREADS=4
C3_DUCKDB_TEMP_DIR=/duckdb/tmp

# ── serving ───────────────────────────────────────────────────
BENTOML_PORT=3000
BENTOML_WORKERS=2
C3_DECISION_THRESHOLD=0.5
C3_ADMIN_TOKEN=change-me

# ── observability (local collector by default; remote filled in later) ──
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.namespace=conquer3
C3_OTEL_COLLECTOR_CONFIG=collector.local.yaml
C3_PROM_REMOTE_WRITE_URL=
C3_PROM_REMOTE_WRITE_USER=
C3_PROM_REMOTE_WRITE_PASSWORD=
C3_OTLP_TEMPO_ENDPOINT=
C3_LOKI_ENDPOINT=
C3_LOKI_USER=
C3_LOKI_PASSWORD=
GRAFANA_URL=

# ── kaggle (local optional; Colab uses userdata secrets instead) ─
KAGGLE_USERNAME=
KAGGLE_KEY=
C3_KAGGLE_DATASET=ealaxi/paysim1
